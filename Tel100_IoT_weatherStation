void readSensors(){
  
  // DHT11, temp is measured in Celsius
  float h = dht.readHumidity();
  float t = dht.readTemperature(); // °C
  if (!isnan(h) && !isnan(t)) {
    humidity = h;
    temp  = t;
  } else {
    Serial.println("DHT read failed");
  }

  // LDR (oversample & EMA)

  // Take a few fast samples and average them to reduce jitter
  const int N = 8;
  long acc = 0;
  for (int i = 0; i < N; i++) {
    acc += analogRead(LDR_PIN);
    delayMicroseconds(300); // short settle
  }
  int raw = acc / N;

  // Update smoothing with Exponential Moving Average (EMA)
  static bool init = false;
  if (!init) { ema = raw; init = true; }
  else       { ema = ALPHA * raw + (1.0f - ALPHA) * ema; }

  // Track observed range for auto-calibration (lowest/highest recored)
  if (raw < seenMin) seenMin = raw;
  if (raw > seenMax) seenMax = raw;

  // Map smoothed value to 0–100% using observed min/max (with guard rails)
  int lo = seenMin;
  int hi = seenMax;
  // 1023 for Arduino UNO , 4095 for MKR 1010 
  if (hi - lo < 10) { lo = 0; hi = 4095; } // until we’ve seen enough variation

  int pct = 0;
  long denom = (long)hi - lo;
  if (denom > 0) {
    long p = (long)(ema - lo) * 100L / denom;
    if (p < 0) p = 0; if (p > 100) p = 100;
    pct = (int)p;
  }
  lightPct = pct;

  // Debug in serial monitor
  Serial.print("T: "); Serial.print(temp, 1);
  Serial.print(" °C  H: "); Serial.print(humidity, 1);
  Serial.print(" %  Light: "); Serial.print(lightPct);
  Serial.print(" % (raw "); Serial.print(raw);
  Serial.print(" range["); Serial.print(seenMin); Serial.print(","); Serial.print(seenMax); Serial.println("])");
}

