#include <SPI.h>
#include <WiFiNINA.h>          // <-- explicitly use WiFiNINA
#include "thingProperties.h"   // contains SECRET_SSID / SECRET_PASS + WiFi connection handler
#include <DHT.h>


// 
#define DHTPIN   7 // evt change to right pin 
#define DHTTYPE  DHT11
#define LDR_PIN  A0
DHT dht(DHTPIN, DHTTYPE);

// Exponential moving average for smoothing
float ema = 0.0f;
const float ALPHA = 0.2f;  // 0..1 (higher = more responsive, lower = smoother)

// Auto-calibration of min/max observed values
// or for Arduino Uno = int seenMin = 1023;
int seenMin = 4095;
int seenMax = 0;


// Heartbeat / demo data
unsigned long lastReport = 0;
unsigned long lastUpdate = 0;

//This function takes an integer status code and prints a corresponding message to the serial monitor, helping to debug WiFi connection issues.
void printStatusName(int s) {
  switch (s) {
    case WL_IDLE_STATUS:      Serial.println("WL_IDLE_STATUS"); break;
    case WL_NO_SSID_AVAIL:    Serial.println("WL_NO_SSID_AVAIL"); break;
    case WL_SCAN_COMPLETED:   Serial.println("WL_SCAN_COMPLETED"); break;
    case WL_CONNECTED:        Serial.println("WL_CONNECTED"); break;
    case WL_CONNECT_FAILED:   Serial.println("WL_CONNECT_FAILED"); break;
    case WL_CONNECTION_LOST:  Serial.println("WL_CONNECTION_LOST"); break;
    case WL_DISCONNECTED:     Serial.println("WL_DISCONNECTED"); break;
    default:                  Serial.print("Unknown ("); Serial.print(s); Serial.println(")"); break;
  }
}

void setup() {
  Serial.begin(9600);
  delay(1500);

  Serial.println("\nMKR1010 + IoT Cloud + WiFiNINA");

  // Sanity checks / info from WiFiNINA
  if (WiFi.status() == WL_NO_MODULE) {
    Serial.println("ERROR: WiFiNINA module not found. Check board/USB.");
    while (true) {}
  }
  Serial.print("WiFiNINA firmware: ");
  Serial.println(WiFi.firmwareVersion());
  Serial.println("Note: MKR1010 supports 2.4 GHz networks only.");

  // Initialize Cloud properties and connect using WiFi (from thingProperties.h)
  initProperties();
  ArduinoCloud.begin(ArduinoIoTPreferredConnection);

  // Verbose Cloud debug during setup
  setDebugMessageLevel(4);
  ArduinoCloud.printDebugInfo();


  // DHT
  pinMode(DHTPIN, INPUT_PULLUP);
  dht.begin();

  Serial.println("Setup complete. Connecting...");
  
}

void loop() {
  // Maintain Cloud/MQTT + WiFi
  ArduinoCloud.update();

  // WIFI checker, for troubleshooting and checking if connected to cloud and wifi
  // Print a small status every 3s = 3000 in value
  if (millis() - lastReport > 5000) {
    lastReport = millis();
    Serial.print("WiFi.status(): ");
    printStatusName(WiFi.status());
    Serial.print("Cloud connected? ");
    Serial.println(ArduinoCloud.connected() ? "yes" : "no");

    if (WiFi.status() == WL_CONNECTED) {
      Serial.print("IP: ");   Serial.println(WiFi.localIP());
      Serial.print("RSSI: "); Serial.print(WiFi.RSSI()); Serial.println(" dBm");
    }
  }
  

  if (millis() - lastUpdate > 2000 && ArduinoCloud.connected()) {
